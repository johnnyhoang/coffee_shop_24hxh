# ==============================================================================
# Coffee Shop 24HXH - Environment Variables Example
# ==============================================================================
# Sao chép file này thành .env để chạy dưới local hoặc cấu hình trên Vercel / Supabase.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
# URL và Public/Anon Key lấy từ Supabase Dashboard (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Base URL API backend:
# - Chạy dưới local: http://localhost:3000/api/v1 (hoặc để trống để dùng Vite proxy /api)
# - Deploy trên Vercel (cùng 1 project monorepo): /api/v1
VITE_APP_API_BASE_URL=/api/v1

# Cấu hình Vite dev server local (tùy chọn)
DEV_SERVER_PORT=5000
DEV_SERVER_HOST=0.0.0.0
DEV_OPEN=false

# ------------------------------------------------------------------------------
# 2. BACKEND API (NestJS / Vercel Serverless)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Kết nối cơ sở dữ liệu PostgreSQL (Supabase):
# - DATABASE_URL: Pooler connection string (hỗ trợ pgbouncer / transaction pooling trên Vercel serverless)
# - DIRECT_URL: Kết nối trực tiếp (Port 5432, khuyến nghị cho migration)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Cấu hình SSL và Logging cho TypeORM
DB_SSL=true
DATABASE_SSL=true
DB_SYNCHRONIZE=false
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Domain cho phép CORS (cách nhau bởi dấu phẩy, dùng khi gọi chéo domain)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5000,http://localhost:3000
