# --- Gửi lên trình duyệt (prefix VITE_) ---
VITE_APP_API_BASE_URL=http://localhost:3000/api/v1

# --- Vercel: thêm biến trên Project → Settings → Environment Variables (Production / Preview) ---
# API production (Nest): https://coffee24hxh-api.vercel.app/api/v1
# VITE_APP_API_BASE_URL=https://coffee24hxh-api.vercel.app/api/v1
# (không dấu / ở cuối. Build lại sau khi đổi biến.)
# Không dùng domain frontend (coffee24hxh.vercel.app) làm API — rewrite SPA trả HTML.

# --- Chỉ dùng khi chạy Vite (vite.config), không bundle ra client ---
DEV_SERVER_PORT=5000
DEV_SERVER_HOST=0.0.0.0
DEV_OPEN=true
