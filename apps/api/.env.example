# Sao chép thành file `.env` và điền mật khẩu (không commit `.env`).

NODE_ENV=development
PORT=3000

# --- Supabase / PostgreSQL ---
# Lấy mật khẩu từ: Project Settings → Database → Database password
# KHÔNG dùng [YOUR-PASSWORD] trong file đã commit; chỉ thay trong `.env` local.

# 1) Session pooler (Shared Pooler, IPv4) — port 5432, host dạng *.pooler.supabase.com
#    Chuỗi mẫu Supabase (thay YOUR-PASSWORD):
#    postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.msozshwatonyxnkaqjfs:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 2) DIRECT_URL: dùng cho migration / công cụ cần kết nối trực tiếp (không qua transaction pooler).
#    Trong Dashboard → Connection string → "Direct connection" (host db.xxx.supabase.co).
#    Nếu chưa tách, có thể tạm trùng DATABASE_URL (session pooler 5432).
DIRECT_URL="postgresql://postgres.msozshwatonyxnkaqjfs:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Transaction pooler (PgBouncer) — thường port 6543, thêm ?pgbouncer=true (dùng khi docs Supabase gợi ý cho serverless)
# DATABASE_URL="postgresql://postgres.msozshwatonyxnkaqjfs:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

DB_SYNCHRONIZE=false
DB_SSL=true
DATABASE_LOGGING=false
